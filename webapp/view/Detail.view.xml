<mvc:View
    controllerName="com.nhpc.zhrinstprcltrs1.controller.Detail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:uxap="sap.uxap"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:upload="sap.m.upload"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    displayBlock="true"
>
    <App id="IPDReimbApp">
        <pages>
            <Page
                id="_IDGenPage1"
                title="{i18n>title}"
                showHeader="false"
            >
                <content>
                    <uxap:ObjectPageLayout
                        id="_IDGenObjectPageLayout1"
                        upperCaseAnchorBar="false"
                    >
                        <uxap:headerTitle>
                            <uxap:ObjectPageDynamicHeaderTitle
                                id="idObjectPageDynamicHeaderTitle"
                            >
                                <uxap:expandedHeading>
                                    <HBox id="idExpandedHBox">
                                        <Avatar
                                            id="idDetailAvatarExpanded"
                                            src="sap-icon://create"
                                            displayShape="Square"
                                        />
                                        <VBox
                                            id="idExpandedVBox"
                                            class="sapUiSmallMarginBegin"
                                        >
                                            <Title
                                                id="idDetailTitleExpanded"
                                                text="{viewModel>/HeaderTitle}"
                                            />
                                            <HBox
                                                id="idExpandedStatusHBox"
                                                renderType="Bare"
                                                wrap="Wrap"
                                            >
                                                <!-- <ObjectStatus
                                                    id="idDetailObjectStatusExpanded"
                                                    title="{i18n>StatusLabel}"
                                                    class="statusBoldText"
                                                    text="{
                                                        path:'viewModel>/PreClearDetails/Status',
                                                        formatter:'.formatter.formatStatusText'
                                                    }"
                                                    state="{
                                                        path:'viewModel>/PreClearDetails/Status',
                                                        formatter:'.formatter.formatStatusState'
                                                    }"
                                                /> -->
                                                <ObjectStatus
                                                    id="idDetailObjectStatusExpanded"
                                                    title="{i18n>StatusLabel}"
                                                    class="statusBoldText"
                                                    text="{viewModel>/PreClearDetails/StatusText}"
                                                    state="{
                                                    path:'viewModel>/PreClearDetails/Status',
                                                    formatter:'.formatter.formatStatusState'
                                                }"
                                                />
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                </uxap:expandedHeading>

                                <uxap:snappedHeading>
                                    <HBox id="idSnappedHBox">
                                        <Avatar
                                            id="idDetailAvatarSnapped"
                                            src="sap-icon://create"
                                            displayShape="Square"
                                        />
                                        <VBox
                                            id="idSnappedVBox"
                                            class="sapUiSmallMarginBegin"
                                        >
                                            <Title
                                                id="idDetailTitleSnapped"
                                                text="{viewModel>/HeaderTitle}"
                                            />
                                            <HBox
                                                id="idSnappedStatusHBox"
                                                renderType="Bare"
                                                wrap="Wrap"
                                            >
                                                <ObjectStatus
                                                    id="idDetailObjectStatusSnapped"
                                                    title="{i18n>StatusLabel}"
                                                    class="statusBoldText"
                                                    text="{viewModel>/PreClearDetails/StatusText}"
                                                    state="{
                                                    path:'viewModel>/PreClearDetails/Status',
                                                    formatter:'.formatter.formatStatusState'
                                                }"
                                                />
                                                <!-- <ObjectStatus
                                                    id="idDetailObjectStatusSnapped"
                                                    title="{i18n>StatusLabel}"
                                                    class="statusBoldText"
                                                    text="{
                                                        path:'viewModel>/PreClearDetails/Status',
                                                        formatter:'.formatter.formatStatusText'
                                                    }"
                                                    state="{
                                                        path:'viewModel>/PreClearDetails/Status',
                                                        formatter:'.formatter.formatStatusState'
                                                    }"
                                                /> -->
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                </uxap:snappedHeading>

                                <!-- <uxap:actions>
                                    <Button
                                        class="sapUiTinyMarginBegin"
                                        type="Reject"
                                        icon="sap-icon://delete"
                                        press="onDeleteDraft"
                                        text="{i18n>Delete}"
                                        visible="{= ${viewModel>/selectedStatus} === 'D'}"
                                    />
                                </uxap:actions> -->
                            </uxap:ObjectPageDynamicHeaderTitle>
                        </uxap:headerTitle>

                        <uxap:headerContent>
                            <FlexBox
                                id="idHeaderFlexBox"
                                fitContainer="true"
                                wrap="Wrap"
                            >
                                <core:Fragment
                                    id="idFragmentEmployeeDetails"
                                    fragmentName="com.nhpc.zhrinstprcltrs1.fragments.EmployeeDetails"
                                    type="XML"
                                />
                            </FlexBox>
                        </uxap:headerContent>

                        <uxap:sections>
                            <uxap:ObjectPageSection
                                id="_IDGenObjectPageSection2"
                                title="{i18n>basicDetails}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection
                                        id="_IDGenObjectPageSubSection2"
                                        titleUppercase="false"
                                    >
                                        <uxap:blocks>
                                            <VBox id="_IDGenVBox4">
                                                <core:Fragment
                                                    id="idFragmentBasicDetails"
                                                    fragmentName="com.nhpc.zhrinstprcltrs1.fragments.BasicDetails"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>

                            <uxap:ObjectPageSection
                                id="_IDGenObjectPageSectionDetails"
                                title="{i18n>detailsOfPartyIndividuals}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection
                                        id="_IDGenObjectPageSubSectionAppDetails"
                                        title="{i18n>applicationDetails}"
                                        titleUppercase="false"
                                    >
                                        <uxap:blocks>
                                            <core:Fragment
                                                fragmentName="com.nhpc.zhrinstprcltrs1.fragments.DetailsParty"
                                                type="XML"
                                            />
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>

                            <uxap:ObjectPageSection
                                id="_IDGenObjectPageSection3"
                                title="{i18n>undertaking}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection
                                        id="_IDGenObjectPageSubSection3"
                                        titleUppercase="false"
                                    >
                                        <uxap:blocks>
                                            <VBox id="_IDGenVBox5">
                                                <core:Fragment
                                                    id="idFragmentUndertaking"
                                                    fragmentName="com.nhpc.zhrinstprcltrs1.fragments.Undertaking"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            <uxap:ObjectPageSection
                                id="_IDGenObjectPageSection4"
                                title="{i18n>HistoryWithRemarks}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection
                                        id="idAprObjSubSecRemark"
                                        visible="{=
                                        ${viewModel>/PreClearDetails/Status} === '02' ||
                                        ${viewModel>/PreClearDetails/Status} === '03' ||
                                        ${viewModel>/PreClearDetails/Status} === '05'
                                    }"
                                    >
                                        <uxap:blocks>
                                            <VBox id="idAprObjSecRemarkVB">
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrinstprcltrs1.fragments.Remarks"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                        </uxap:sections>
                    </uxap:ObjectPageLayout>
                </content>

                <footer>
                    <OverflowToolbar id="_IDGenOverflowToolbar1">
                        <ToolbarSpacer id="_IDGenToolbarSpacer1" />

                        <Button
                            id="idSaveBtn"
                            text="{i18n>Save}"
                            icon="sap-icon://save"
                            type="Critical"
                            press="handleSaveBtnPress"
                            visible="{viewModel>/editable}"
                        />

                        <Button
                            id="idStopHRABtnBtn"
                            text="{i18n>Submit}"
                            icon="sap-icon://create"
                            type="Success"
                            press="handleSubmitBtnPress"
                            visible="{viewModel>/editable}"
                        />
                    </OverflowToolbar>
                </footer>
            </Page>
        </pages>
    </App>
</mvc:View>
